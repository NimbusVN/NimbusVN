<?xml version="1.0" encoding="utf-8"?>
<!--
    全局设置面板 - 完全重新设计
    统一管理所有全局参数
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_medium"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="全局设置"
        android:textColor="@color/primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="@color/text_muted" />

    <!-- 平台段选择：决定 system.ini 走哪个 OS 段（[android] / [windows]） -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="平台"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <RadioGroup
        android:id="@+id/group_platform"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/button_platform_android"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="android"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/button_platform_windows"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:text="windows"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </RadioGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/bg_card" />

    <!-- 游戏目录扫描：递归深度 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="游戏目录扫描"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/text_scandepth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="递归深度：1 层（只扫所选目录的直接子目录）"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <SeekBar
        android:id="@+id/seek_scandepth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:max="5"
        android:progress="0"
        android:progressTint="@color/secondary"
        android:thumbTint="@color/secondary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="调到 2 层以上时，选 data 也能扫出 data/krkr、data/artemis。下钻时只把带 xp3 / pfs / system.ini 的目录当成游戏，纯文件夹会继续往下找。"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/bg_card" />

    <!-- 其他功能 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="其他"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <CheckBox
        android:id="@+id/button_scopedsavedir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="隔离存档目录"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <CheckBox
        android:id="@+id/button_alloweditargs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="允许编辑启动参数"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/bg_card" />

    <!-- 底部信息 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <Button
                android:id="@+id/button_checkupdate"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/btn_primary"
                android:text="检查更新"
android:textColor="@color/white"
            android:textSize="11sp" />

            <Button
                android:id="@+id/button_about"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_secondary"
                android:text="关于"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="@string/app_version"
            android:textColor="@color/primary"
            android:textSize="24sp" />
    </LinearLayout>

</LinearLayout>
